# Production (Vercel)
# Required when NODE_ENV=production — validated at startup via instrumentation.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the browser or NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Cron ingestion auth (Milestone 5+)
# Vercel Cron sends: Authorization: Bearer $CRON_SECRET
CRON_SECRET=

# Donation health (Milestone 10+) — optional one-shot script:
# npx tsx scripts/run-donation-health.mts

# External sources (Milestone 5+)
# Request a pre-approved appname: https://apidoc.reliefweb.int/parameters#appname
RELIEFWEB_APP_NAME=

# Seismic (Milestone 6+) — optional pin to a specific SGC event id
# SEISMIC_PRIMARY_EVENT_ID=SGC2026qqvhgo
# SEISMIC_MIN_MAGNITUDE=4

# IFRC GO (Milestone 9+) — optional pin to a specific GO event id
# IFRC_EVENT_ID=8055

# Manual metrics import (Milestone 7+):
# POST /api/admin/metrics/import with Authorization: Bearer $CRON_SECRET
# See scripts/examples/ungrd-metrics-import.json
